<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Live navigation: satellite GPS fix only (see LocationTracker) — never
         used to request network/cell-tower based location, which on stock
         Android resolves via an online Google service and would break the
         fully-offline requirement. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Android 12+ silently downgrades a FINE-only request to COARSE-only
         unless COARSE is also declared — this app's own code only ever acts
         on a granted ACCESS_FINE_LOCATION (see MainActivity/SearchLocation-
         Activity/LiveNavigationActivity), so without this the live-GPS path
         would quietly stop working on modern devices. Still satellite-GPS
         only: LocationTracker never touches NETWORK_PROVIDER, so declaring
         this doesn't pull in any online/network location lookups. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />
    <!-- This app targets keypad-only devices with no touchscreen (see
         feedback-movitop-dpad-convention) — without this, Android treats
         a touchscreen as required by default and filters the app away from
         exactly the hardware it's built for. -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name="androidx.multidex.MultiDexApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Movitop">
        <activity
            android:name=".SplashActivity"
            android:theme="@style/Theme.Movitop.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".MainActivity" />

        <activity
            android:name=".search.SearchLocationActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity android:name=".DataImportActivity" />

        <activity android:name=".SettingsActivity" />

        <activity android:name=".LineTimesActivity" />

        <activity
            android:name=".LiveNavigationActivity"
            android:screenOrientation="portrait" />

        <service
            android:name=".MotisForegroundService" />
    </application>

</manifest>